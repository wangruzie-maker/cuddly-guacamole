APP_HOST=0.0.0.0
APP_PORT=8765
APP_RELOAD=0
APP_CORS_ORIGINS=*
# 默认手动运行采集；确需后台定时采集时改为 1
INTEL_SCHEDULER_ENABLED=0
# 线上 API 严格鉴权（仅服务间调用时开启；浏览器本地使用请保持注释状态）
# INTEL_SERVICE_TOKEN=your-secret
# INTEL_STRICT_AUTH=1

# 腾讯云 TokenHub · DeepSeek
# 文档：https://cloud.tencent.com/document/product/1823/132248
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://tokenhub.tencentmaas.com/v1
# DEEPSEEK_MODEL=deepseek-v4-pro
# 更便宜可选：deepseek-v4-flash / deepseek-v3.2
